#Mức độ easy nên tương đối dễ để nghĩ ra cách giải
class Solution:
    def makeFancyString(self, s: str) -> str:
        a = "" + s[:2]
        for i in range(2, len(s)):
            if (s[i-1] == s[i-2]):
                if (s[i] == s[i-1]):
                    continue
                else:
                    a += s[i]
            else: 
                a += s[i]
        return a
